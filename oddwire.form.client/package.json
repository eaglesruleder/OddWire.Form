{
  "name": "oddwire.form.client",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "vite build --mode library && tsc -p tsconfig.lib.json",
    "verify:package": "node tools/verify-package.mjs",
    "prepack": "npm run build:package",
    "lint": "eslint .",
    "test": "vitest run",
    "pr": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "preview:boxes": "node tools/box-preview.mjs",
    "template:monster-card": "node tools/build-card-pair-template.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist-package/types/index.d.ts",
      "import": "./dist-package/index.js"
    },
    "./styles.css": "./dist-package/styles.css"
  },
  "types": "./dist-package/types/index.d.ts",
  "files": [
    "dist-package",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "react-bootstrap": "^2.10.10",
    "react-router-dom": "^7.18.1",
    "react-swipeable-list": "^1.10.0",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
